<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <TextureView
        android:id="@+id/mainPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/hud"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <TextureView
        android:id="@+id/cabinPreview"
        android:layout_width="200dp"
        android:layout_height="113dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/recStatus"
            style="@style/Pill"
            android:text="STANDBY" />

        <TextView
            android:id="@+id/gpsStatus"
            style="@style/Pill"
            android:layout_marginTop="6dp"
            android:text="GPS: searching" />

        <TextView
            android:id="@+id/focusStatus"
            style="@style/Pill"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/warning"
            style="@style/Pill"
            android:layout_marginTop="6dp"
            android:maxWidth="380dp"
            android:textColor="#FFCC80"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/speedBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/pill_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/speedMph"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="-- mph"
            android:textColor="@android:color/white"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/speedKph"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="-- km/h"
            android:textColor="#CCFFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/settingsBtn"
            style="@style/CtlButton"
            android:text="⚙" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/clipsBtn"
            style="@style/CtlButton"
            android:text="🎞 Clips" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/focusBtn"
            style="@style/CtlButton"
            android:text="Focus ∞" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/lockBtn"
            style="@style/CtlButton"
            android:text="🔒 Lock" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/recBtn"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/rec_button"
            android:contentDescription="Record" />
    </LinearLayout>
    </FrameLayout>
</FrameLayout>
