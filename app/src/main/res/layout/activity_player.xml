<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="vertical">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:textColor="@android:color/white"
        android:textSize="15sp" />

    <!-- Orientation is set in code: side by side in landscape, stacked in portrait. -->
    <LinearLayout
        android:id="@+id/videos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/frontBox"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <VideoView
                android:id="@+id/frontVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

            <TextView style="@style/Pill" android:layout_margin="8dp" android:text="FRONT" android:textSize="12sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/rearBox"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <VideoView
                android:id="@+id/rearVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

            <TextView style="@style/Pill" android:layout_margin="8dp" android:text="REAR" android:textSize="12sp" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/playBtn"
            style="@style/CtlButton"
            android:layout_marginStart="0dp"
            android:text="▶" />

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:text="0:00 / 0:00"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/seek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/modeFront" style="@style/CtlButton" android:layout_marginStart="0dp" android:text="Front" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/modeBoth" style="@style/CtlButton" android:text="Both" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/modeRear" style="@style/CtlButton" android:text="Rear" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/lockBtn" style="@style/CtlButton" android:layout_marginStart="20dp" android:text="🔒 Lock" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/shareBtn" style="@style/CtlButton" android:text="Share" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/saveBtn" style="@style/CtlButton" android:text="Save to gallery" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/deleteBtn" style="@style/CtlButton" android:text="Delete" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
